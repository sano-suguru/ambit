{
  // `scripts/` is outside `tsconfig.json`'s `include` (AGENTS.md). The resident
  // benchmark is the exception: its numbers decide architecture, and it
  // imports nothing that is not installed, so it is checked on its own here.
  "extends": "./tsconfig.json",
  "include": ["scripts/bench-resident.ts", "scripts/bench-resident/**/*.ts"]
}
